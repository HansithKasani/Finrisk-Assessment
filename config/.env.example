# Environment Variables Template
# Copy to .env and fill with actual values
# ⚠️ WARNING: Never commit .env to version control!

# Application Settings
FLASK_ENV=development
DEBUG=False
LOG_LEVEL=INFO
APP_NAME=CreditRiskAssessment
APP_VERSION=1.0.0

# Model Configuration
MODEL_PATH=Models/credit_risk_xgboost_model.pkl
ENCODER_PATH=Models/credit_risk_encoder.pkl
SCALER_PATH=Models/credit_risk_scaler.pkl
MODEL_THRESHOLD=0.20
USE_EXPLAINABILITY=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/credit_risk_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Redis Configuration (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=5

# AWS Configuration (for deployment)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=credit-risk-models
AWS_SECRETS_MANAGER_REGION=us-east-1

# Azure Configuration (alternative to AWS)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT=

# GCP Configuration (alternative)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=30

# Authentication
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY=your_api_key_here

# OAuth (if using)
OAUTH_PROVIDER=google  # or github, microsoft
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@creditrisk.com
ALERT_EMAIL=admin@creditrisk.com

# Slack Notifications
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
SLACK_USERNAME=CreditRiskBot

# Monitoring & Logging
SENTRY_DSN=
LOG_FILE_PATH=logs/app.log
LOG_ROTATION_DAYS=7
DATADOG_API_KEY=
PROMETHEUS_ENABLED=True

# Feature Store
FEAST_REGISTRY_PATH=file:///path/to/registry
FEAST_ONLINE_STORE=redis

# Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://user:password@localhost/mlflow
MLFLOW_ARTIFACT_ROOT=s3://bucket/mlflow-artifacts

# Data Configuration
DATA_RAW_PATH=Data/raw/
DATA_PROCESSED_PATH=Data/processed/
DATA_BACKUP_PATH=Data/backups/
RANDOM_SEED=42

# Feature Engineering
HANDLE_MISSING=median
OUTLIER_DETECTION=true
OUTLIER_METHOD=iqr

# Model Training
TRAIN_TEST_SPLIT=0.8
CROSS_VALIDATION_FOLDS=5
SMOTE_RATIO=1.0
EARLY_STOPPING_ROUNDS=50

# Performance Monitoring
MODEL_ACCURACY_THRESHOLD=0.80
DATA_DRIFT_THRESHOLD=0.05
PERFORMANCE_CHECK_FREQUENCY=hourly

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# HTTPS/SSL
HTTPS_ONLY=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Third-Party Services
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# Development Settings
DEBUG_MODE=false
PROFILE_REQUESTS=false
VERBOSE_LOGGING=false
MOCK_PREDICTIONS=false

# Batch Processing
BATCH_CHUNK_SIZE=1000
BATCH_WORKERS=4
BATCH_TIMEOUT=3600

# Explainability
SHAP_ENABLED=true
LIME_ENABLED=true
SHAP_BACKGROUND_SAMPLES=1000
LIME_NUM_SAMPLES=5000

# Compliance & Audit
AUDIT_LOGGING=true
AUDIT_LOG_PATH=logs/audit.log
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true
HIPAA_COMPLIANCE=false

# Feature Flags
ENABLE_BATCH_PREDICTIONS=true
ENABLE_EXPLANATIONS=true
ENABLE_DATA_DRIFT_DETECTION=true
ENABLE_MODEL_MONITORING=true

# Version Control & Deployment
GIT_REPO_URL=https://github.com/yourusername/credit-risk-assessment
DEPLOYMENT_ENV=production
ROLLBACK_ENABLED=true

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://bucket/backups

# Custom Settings
CUSTOM_THRESHOLD=0.20
FEATURE_IMPORTANCE_METHOD=shap
EXPLAINER_TYPE=tree
